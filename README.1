.SH DBG_ALLOC
\fBdbg_alloc\fR \- catch memory bugs\&.
.PP
.SH DESCRIPTION
This small library that can trace memory bugs:
\fBMemory Leak\fR, \fBHeap corruption\fR, \fBDouble Free\fR,
\fBStack smashing\fR\&.
.PP
.SH FEATURES
.br
\fB\-\-\fR \fBC89\fR/\fBANSI C\fR code standard\&.
.br
\fB\-\-\fR \fBstb\-style\fR library\&.
.PP
.SH QUICK START
.nf
.RS 4
#define DBG_ALLOC_SOURCE
/* Can wrap malloc() function */
#define WRAP_REAL_MALLOC
#include "dbg_alloc\&.h"

#include <stdlib\&.h>

int main(void) {
  int* test_data = NULL;
  
  /* Initialize allocator once: */
  InitAllocator(4096/*bytes*/);

  test_data = malloc(sizeof(int));

  /* Forget free! Running log\&. */
  AllocatorLog();

  /* Clear allocator: */
  KillAllocator();

  /* Program will be aborted\&. */
  return 0;
}
.fi
.RE
.PP
.PP
